flowchart TD
  crash(["某个节点崩溃<br/>token 不再传回来"]) --> warn["2250 ms：日志告警<br/>Token has not been received"]
  warn --> lost["3000 ms：token 超时<br/>A processor failed, forming new configuration"]

  subgraph totem["Corosync Totem 成员协议"]
    lost --> gather["GATHER<br/>每 50 ms 广播 join，consensus 计时 3600 ms"]
    gather -- "consensus 超时<br/>没回应的节点记为失败" --> commit["COMMIT<br/>确认新成员名单"]
    commit --> recovery["RECOVERY<br/>补发旧成员里没送达的消息"]
    recovery --> op["OPERATIONAL<br/>A new membership was formed"]
  end

  op -- "confchg：TRANSITIONAL 再 REGULAR" --> services["Corosync 内部服务<br/>quorum 服务 · CPG"]

  subgraph pcmk["Pacemaker 2.1.11"]
    qcb["quorum_notification_cb<br/>节点状态：member / lost"]
    ccb["pcmk__cpg_confchg_cb<br/>进程在不在线"]
    peer["controld：peer_update_callback"]
    qcb --> peer
    ccb --> peer
    peer -- "掉的是 DC" --> elect["发起选举"]
    peer -- "自己是 DC" --> abort["中止当前 transition<br/>重新计算"]
  end

  services -- "quorum 变化" --> qcb
  services -- "CPG 组成员变化" --> ccb
