---
import Base from "../layouts/Base.astro";
import { stageRef, stepChecked } from "../data/network";
import { nextStage, progress } from "../data/roadmap";
import { site } from "../data/site";
import { storyline } from "../data/storyline";

const next = stageRef(nextStage.no);
const lit = storyline.filter((s) => stepChecked(s.stages)).length;

/** 一次调度回路，取自上游文档 Pacemaker Explained §1.2.2。 */
const loop = [
  { name: "事件发生", who: "节点掉线 · monitor 失败 · 配置变更" },
  { name: "DC 取一份 CIB 快照", who: "pacemaker-controld → pacemaker-based" },
  { name: "调度器算出动作图", who: "pacemaker-schedulerd" },
  { name: "启停资源，必要时隔离节点", who: "pacemaker-execd · pacemaker-fenced" },
  { name: "结果写回 CIB，进入下一轮", who: "pacemaker-based" },
];
---

<Base>
  <section class="shell hero">
    <div>
      <p class="eyebrow">对照 Pacemaker {site.upstream.version} 源码</p>
      <h1 class="display">集群为什么<br />这样做决定。</h1>
      <p class="lede">
        AI 对照 <a href={site.upstream.href}>Pacemaker {site.upstream.version}</a> 的文档和源码，一讲拆开一件事：
        节点怎么判定掉线、资源该放哪、什么时候必须 fencing。我跟着读、追问。
      </p>

      <a class="next-block" href={next.href}>
        <span>
          <span class="next-block__label">下一讲</span>
          <span class="next-block__title">第 {Number(next.no)} 讲 · {next.title}</span>
        </span>
        <span class="next-block__arrow" aria-hidden="true">→</span>
      </a>

      <div class="hero__actions">
        <a class="action" href="/notes/">读已发的讲义</a>
        <a class="action action--quiet" href="/network/">看知识网络</a>
      </div>

      <p class="facts">
        <span>已发 {progress.notes} / {progress.total} 讲</span>
        <span>故障主线点亮 {lit} / {storyline.length} 步</span>
      </p>
    </div>

    <div class="loop">
      <p class="loop__title">一次调度回路</p>
      <ol class="loop__steps">
      {
        loop.map((step, i) => (
          <li class="loop__step">
            <span class="loop__no">{i + 1}</span>
            <span class="loop__name">{step.name}</span>
            <span class="loop__who">{step.who}</span>
          </li>
        ))
      }
      </ol>
    </div>
  </section>
</Base>
