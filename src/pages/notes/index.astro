---
import { getCollection } from "astro:content";

import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="讲义" description="学 Pacemaker 的讲义：每篇讲清一个阶段，引用固定版本的上游文档和源码。">
  <div class="shell page-head">
    <p class="eyebrow">讲义</p>
    <h1 class="display">一次一个阶段</h1>
    <p class="lede">
      每篇对应<a href="/roadmap/">学习路线</a>上的一个阶段，引用 Pacemaker-2.1.11 的文档或源码；
      在实验平台上验证过的，附上验证摘要。
    </p>
  </div>

  <div class="shell">
    {
      notes.length === 0 ? (
        <p class="lede" style="padding-block:3rem">还没有讲义。</p>
      ) : (
        <ul class="note-list">
          {notes.map((note) => (
            <li class="note-list__item">
              <p class="note-meta">
                <time datetime={note.data.date.toISOString()}>
                  {note.data.date.toISOString().slice(0, 10)}
                </time>
                {` · ${note.data.layer}`}
                {note.data.stage ? ` · 第 ${Number(note.data.stage)} 讲` : ""}
              </p>
              <h2>
                <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              </h2>
              <p style="margin:0;color:var(--ink-muted)">{note.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
