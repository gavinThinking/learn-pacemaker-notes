---
import { getCollection, render } from "astro:content";

import { edgesOf, stageRef } from "../../data/network";

import Diagram from "../../components/Diagram.astro";
import Sketch from "../../components/Sketch.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const edges = edgesOf(notes);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, backlinks: edges.filter((e) => e.to === note.data.stage) },
  }));
}

const { note, backlinks } = Astro.props;
const outlinks = note.data.links.map((l) => ({ ...stageRef(l.to), why: l.why }));
const inlinks = backlinks.map((e) => ({ ...stageRef(e.from), why: e.why }));
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.summary} published={note.data.date}>
  <div class="shell page-head">
    <p class="note-meta">
      <time datetime={note.data.date.toISOString()}>
        {note.data.date.toISOString().slice(0, 10)}
      </time>
      {` · ${note.data.layer}`}
      {note.data.stage ? ` · 阶段 ${note.data.stage}` : ""}
    </p>
    <h1 class="display">{note.data.title}</h1>
    <p class="lede">{note.data.summary}</p>
  </div>

  <div class="shell">
    <article class="prose">
      <!-- 手记里直接写 <Diagram name="..." /> 或 <Sketch slug="..." /> 即可内嵌架构图、图解，不必自己 import。 -->
      <Content components={{ Diagram, Sketch }} />

      {
        note.data.evidence.length > 0 && (
          <>
            <h2>平台验证</h2>
            <ul>
              {note.data.evidence.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </>
        )
      }

      {
        (outlinks.length > 0 || inlinks.length > 0) && (
          <>
            <h2>和其他阶段的连接</h2>
            {outlinks.length > 0 && (
              <>
                <p>这篇连到：</p>
                <ul>
                  {outlinks.map((s) => (
                    <li>
                      <a href={s.href}>阶段 {s.no} · {s.title}</a>
                      {!s.written && "（待写）"}：{s.why}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {inlinks.length > 0 && (
              <>
                <p>指向这篇的：</p>
                <ul>
                  {inlinks.map((s) => (
                    <li>
                      <a href={s.href}>阶段 {s.no} · {s.title}</a>：{s.why}
                    </li>
                  ))}
                </ul>
              </>
            )}
            <p>
              全部连接和贯穿各阶段的故障主线见<a href="/network/">知识网络</a>。
            </p>
          </>
        )
      }

      {
        note.data.upstream.length > 0 && (
          <p class="evidence-links">
            {note.data.upstream.map((u) => (
              <a href={u.href}>{u.label}</a>
            ))}
          </p>
        )
      }
    </article>
  </div>
</Base>
