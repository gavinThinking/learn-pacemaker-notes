---
import { getCollection, render } from "astro:content";

import Diagram from "../../components/Diagram.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.summary} published={note.data.date}>
  <div class="shell page-head">
    <p class="note-meta">
      <time datetime={note.data.date.toISOString()}>
        {note.data.date.toISOString().slice(0, 10)}
      </time>
      {` · ${note.data.layer}`}
      {note.data.stage ? ` · 阶段 ${note.data.stage}` : ""}
    </p>
    <h1 class="display">{note.data.title}</h1>
    <p class="lede">{note.data.summary}</p>
  </div>

  <div class="shell">
    <article class="prose">
      <!-- 手记里直接写 <Diagram name="..." /> 即可内嵌架构图，不必自己 import。 -->
      <Content components={{ Diagram }} />

      {
        note.data.evidence.length > 0 && (
          <>
            <h2>平台验证</h2>
            <ul>
              {note.data.evidence.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </>
        )
      }

      {
        note.data.upstream.length > 0 && (
          <p class="evidence-links">
            {note.data.upstream.map((u) => (
              <a href={u.href}>{u.label}</a>
            ))}
          </p>
        )
      }
    </article>
  </div>
</Base>
