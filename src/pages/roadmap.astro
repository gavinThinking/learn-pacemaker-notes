---
import SketchGrid from "../components/SketchGrid.astro";
import Base from "../layouts/Base.astro";
import { layers, progress, statusLabels, statusOf } from "../data/roadmap";
import { site } from "../data/site";
import { sketches } from "../data/sketches";
---

<Base
  title="学习路线"
  description="按 Pacemaker 自己的分工拆出的 6 层 14 个阶段，以及每个阶段的手记。"
>
  <div class="shell page-head">
    <p class="eyebrow">6 层 · 对照 Pacemaker {site.upstream.version}</p>
    <h1 class="display">学到哪了，一页说清</h1>
    <p class="lede">
      从下往上排：成员与 quorum 是地基，调度决策是核心，fencing 是安全底线，最后用在 PostgreSQL 主备上。
      每个阶段只看一样产出：手记发了没有。只是读过资料不算产出；在实验平台上验证过的会另外标出来，不影响状态。
    </p>

    <div class="progress-bar" aria-hidden="true">
      {
        layers
          .flatMap((layer) => layer.stages)
          .map((s) => <span class="progress-bar__cell" data-status={statusOf(s)} />)
      }
    </div>
    <p class="note-meta">
      {progress.total} 个阶段 · 手记 {progress.notes} 篇 · 平台验证 {progress.evidence} 项
    </p>
  </div>

  <div class="shell">
    {
      layers.map((layer) => (
        <section class="part" id={layer.no}>
          <header class="part__head">
            <span class="part__no">{layer.no}</span>
            <div>
              <h2 class="part__name">{layer.name}</h2>
              <p class="part__goal">{layer.goal}</p>
            </div>
            <span class="part__count">
              {layer.stages.filter((s) => statusOf(s) === "done").length}/{layer.stages.length}
            </span>
          </header>

          {layer.stages.map((stage) => (
            <article class="cp" data-status={statusOf(stage)}>
              <span class="cp__no">{stage.no}</span>
              <div>
                <h3 class="cp__title">{stage.title}</h3>
                <p class="cp__summary">{stage.summary}</p>
                {stage.evidence && <span class="cp__caveat">平台验证：{stage.evidence}</span>}
                {(stage.upstream || stage.note) && (
                  <p class="cp__links">
                    {stage.upstream && (
                      <a href={`${site.upstream.href}/${stage.upstream}`}>上游 · {stage.upstream}</a>
                    )}
                    {stage.note && <a href={`/notes/${stage.note}/`}>读手记 →</a>}
                  </p>
                )}
              </div>
              <span class="pill" data-status={statusOf(stage)}>
                {statusLabels[statusOf(stage)]}
              </span>
            </article>
          ))}

          {sketches.some((s) => s.group === layer.no) && (
            <div class="part__sketches">
              <p class="part__sketches-label">这一层的图解</p>
              <SketchGrid items={sketches.filter((s) => s.group === layer.no)} compact />
            </div>
          )}
        </section>
      ))
    }
  </div>

  <div class="shell section">
    <h2 class="section__title">状态怎么定</h2>
    <div class="cards">
      <article class="card">
        <span class="card__no">手记已发</span>
        <h3>这个阶段的手记发布了</h3>
        <p>手记讲清这个阶段的机制，源码结论链到 2.1.11 tag，没核对源码的标明只依据文档。</p>
      </article>
      <article class="card">
        <span class="card__no">未开始</span>
        <h3>还没有手记</h3>
        <p>读过资料但没写成手记，也算未开始。</p>
      </article>
      <article class="card">
        <span class="card__no">平台验证</span>
        <h3>可选的补充</h3>
        <p>在自建集群上实际跑过的阶段，下面多一行验证摘要。没有这一行不影响完成。</p>
      </article>
    </div>
  </div>
</Base>
